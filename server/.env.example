JWT_SECRET=change-this-to-a-long-random-string-in-production
PORT=3001
# Allowed browser origin for CORS (frontend URL)
CORS_ORIGIN=http://localhost:5173
# Base URL used in password-reset links
APP_URL=http://localhost:5173
# SQLite file path (defaults to the bundled location)
# DB_PATH=
# SMTP for password-reset emails; if unset, emails are logged to the console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
